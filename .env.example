# Copy to .env for local development (`cp .env.example .env`).

# --- Database (Postgres 14+) ---------------------------------------------
# Local: `docker compose up -d db` starts one matching this URL.
# Hosted (Neon, Supabase, RDS…): add ?sslmode=require
DATABASE_URL=postgres://kusa:kusa@localhost:5432/kusa

# How "near me" searches run:
#   basic   = latitude/longitude with an indexed bounding box. Any Postgres. (default)
#   postgis = PostGIS geography column + spatial index; the database filters by
#             radius and sorts nearest first. Needs the PostGIS extension (Neon,
#             Supabase, RDS and the docker-compose database have it). If it can't
#             be enabled, the server logs why and uses basic. Switch any time.
GEO_SEARCH=basic

# Load the demo businesses, shoppers and reviews into an empty database.
# On by default in development; leave unset/false in production.
# SEED_DEMO_DATA=true

# --- Sign-in --------------------------------------------------------------
# Secret for signing codes and private file links. Required in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Phone numbers that become admins when they sign in (comma-separated).
ADMIN_PHONES=

# console = codes are logged and shown on screen (development only)
# termii  = real SMS through Termii (https://termii.com)
SMS_PROVIDER=console
DEV_OTP_CODE=123456
TERMII_API_KEY=
TERMII_SENDER_ID=Kusa
# Your account's base URL from the Termii dashboard
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=dnd

# --- Photo uploads --------------------------------------------------------
# Without S3 settings, photos are stored on disk in UPLOADS_DIR.
UPLOADS_DIR=./.data/uploads
# S3-compatible storage (Cloudflare R2, AWS S3, Backblaze B2…)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- App ------------------------------------------------------------------
# Public site address, used for share links.
NUXT_PUBLIC_SITE_URL=https://kusa.ng
# Where the native apps reach the API. Set this when running `npm run cap:sync`.
# NUXT_PUBLIC_API_BASE=https://kusa.ng/api
# Show the demo account buttons on the sign-in page outside development.
# NUXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
# Origins allowed to call the API from a browser (the native apps by default).
# CORS_ORIGINS=capacitor://localhost,http://localhost,https://localhost
