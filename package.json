{
  "name": "kusa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kusa: find small businesses near you. Web app (Nuxt) with native iOS and Android shells (Capacitor).",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "generate:app": "cross-env KUSA_TARGET=app nuxt generate",
    "cap:sync": "npm run generate:app && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env server/database/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env server/database/cli.ts seed",
    "db:reset": "tsx --env-file-if-exists=.env server/database/cli.ts reset",
    "db:studio": "drizzle-kit studio",
    "test:api": "node tests/api.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "nodemailer": "^6.10.1",
    "nuxt": "^4.6.2",
    "pg": "^8.23.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.20",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.13"
  }
}
